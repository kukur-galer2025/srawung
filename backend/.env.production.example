# ============================================================================
#  Amania — contoh .env untuk SERVER PRODUKSI
#  Salin menjadi backend/.env di server, isi nilai bertanda <...>, lalu jalankan:
#    php artisan amania:preflight
#  Panduan lengkap: deploy/README.md
# ============================================================================

APP_NAME=Amania
APP_ENV=production
# WAJIB false di server: true membocorkan detail error & konfigurasi ke publik.
APP_DEBUG=false
# Buat sekali dengan "php artisan key:generate --show". Jangan diganti setelah online.
APP_KEY=<base64:...>
APP_URL=https://api.<domain-anda>
# Semua waktu disimpan & ditampilkan dalam WIB (lihat config/app.php).
APP_TIMEZONE=Asia/Jakarta
DB_TIMEZONE=+07:00
FRONTEND_URL=https://<domain-anda>

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Proxy di depan PHP. Nginx CloudPanel meneruskan dari 127.0.0.1 (nilai bawaan bila kosong).
# JANGAN isi "*" selama server masih bisa dibuka langsung lewat IP-nya: siapa pun bisa memalsukan
# alamat IP dan melewati semua pembatas. Di belakang Cloudflare, isi rentang IP Cloudflare.
TRUSTED_PROXIES=127.0.0.1

# IP server frontend (Next.js), agar halaman yang dibuat server tidak dibatasi sebagai satu pengunjung.
SSR_IPS=127.0.0.1,::1,<IP-server>

# Masa berlaku login (jam).
ADMIN_TOKEN_HOURS=12
CREATOR_TOKEN_HOURS=168
BUYER_TOKEN_HOURS=720

# Log harian, disimpan 14 hari, hanya peringatan ke atas.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amania_books
# Buat user khusus aplikasi — JANGAN pakai root di server.
DB_USERNAME=amania
DB_PASSWORD=<kata-sandi-kuat>

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=2000
CACHE_STORE=database

# Email: sebaiknya layanan email transaksional dengan domain sendiri
# (Brevo / Resend / Amazon SES) + SPF, DKIM, DMARC. Gmail dibatasi ±500/hari.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-relay.brevo.com>
MAIL_PORT=587
MAIL_USERNAME=<username-smtp>
MAIL_PASSWORD=<kata-sandi-smtp>
MAIL_FROM_ADDRESS="halo@<domain-anda>"
MAIL_FROM_NAME="Amania"

# Login Google (opsional) — harus sama dengan NEXT_PUBLIC_GOOGLE_CLIENT_ID frontend.
GOOGLE_CLIENT_ID=

# Poppler (apt install poppler-utils) biasanya terdeteksi otomatis di Linux.
PDF_CONVERTER_PATH=

# Peringatan email ke admin (alamat diatur di Admin → Pengaturan).
HEALTH_MIN_FREE_DISK_PERCENT=10
HEALTH_ALERT_COOLDOWN_HOURS=6

# Pemantauan error (opsional): sentry.io → buat proyek Laravel → salin DSN.
# Tanpa ini, error tetap dikirim ke email admin (dibatasi 1×/jam per jenis error).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Newsletter dikirim bertahap (email per menit). Gmail ±500/hari → jangan terlalu tinggi.
NEWSLETTER_PER_MINUTE=20
